# 사이트 기준 도메인 (선택)
# canonical과 OG, sitemap의 절대 URL이 이 값에서 나옵니다
# 비워 두면 Vercel 프로덕션에서는 기본 도메인을, 로컬에서는 http://localhost:3100 을 씁니다
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Giscus 댓글 설정
# https://giscus.app 에서 설정값을 생성할 수 있습니다
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=your-repo-id
NEXT_PUBLIC_GISCUS_CATEGORY=your-category
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your-category-id

# Vercel Private Submodule 설정 (프로덕션 전용)
# GitHub Personal Access Token (repo 권한 필요)
# https://github.com/settings/tokens 에서 생성
GITHUB_REPO_CLONE_TOKEN=your-github-personal-access-token

# Upstash Redis (조회수) 설정
# Vercel Marketplace에서 Redis 통합을 추가하면 자동으로 주입됩니다
# https://vercel.com/marketplace?category=storage&search=redis
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 검색 엔진 소유 확인 (선택)
# 값을 비워 두면 해당 meta 태그가 나가지 않습니다
# 구글: https://search.google.com/search-console 의 HTML 태그 확인에서 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-content
# 네이버: https://searchadvisor.naver.com 의 사이트 소유확인 HTML 태그에서 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=your-naver-site-verification-content





